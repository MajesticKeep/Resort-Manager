                <mxCell id="room" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#9a783e;fontColor=#162e36;" value="&lt;b&gt;Room (configurable)&lt;/b&gt;&lt;hr&gt;- roomId: String&lt;br&gt;- roomType: String&lt;br&gt;- viewType: String&lt;br&gt;- rate: double&lt;br&gt;- capacity: int&lt;br&gt;- maxExtraGuests: Integer&lt;br&gt;- status: RoomStatus&lt;br&gt;- includedAmenities: List&lt;hr&gt;+ getMaximumGuestCount(): int&lt;br&gt;+ calculateRate(): double&lt;br&gt;+ isAvailable(dates): boolean" vertex="1">
